# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored — never commit real secrets.

# --- Server ---
# macOS uses port 5000 for AirPlay Receiver, so use 3000 locally.
PORT=3000
# Public URL of this deployment (no trailing slash). Locally: http://localhost:3000
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Local (Homebrew Postgres / Postgres.app):
DATABASE_URL=postgres://localhost:5432/lecturequest
# Neon (production) example:
# DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# --- Sessions ---
# Generate with:  openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Google Sign-In (https://console.cloud.google.com/apis/credentials) ---
# Authorised redirect URI must be exactly: <APP_URL>/api/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict sign-in to certain email domains (comma-separated)
# ALLOWED_EMAIL_DOMAINS=ucl.ac.uk

# Local development only: one-click "Dev login" without Google. Ignored in production.
DEV_AUTH_BYPASS=false

# --- AI ---
ANTHROPIC_API_KEY=
