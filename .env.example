# Use a development Neon database, not your production database.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# Needed to generate quizzes; not required for Google sign-in or the lecture library.
ANTHROPIC_API_KEY=
APP_ORIGIN=http://localhost:5000
PORT=5000
# Set to 1 only when exactly one trusted reverse proxy sits directly in front of the app.
TRUST_PROXY=0
# Optional: a comma-separated list of verified emails for a private beta.
GOOGLE_ALLOWED_EMAILS=
